output eDP-1 scale 2

profile mobile {
	output eDP-1 enable position 0,0
}

profile home {
	output eDP-1 disable
	output 'Acer Technologies XV273K 0x91709387' enable mode 3840x2160 position 0,0 scale 2
	output 'ViewSonic Corporation VG2448 V5E203460376' enable mode 1920x1080 position 1920,0
}

profile home-reduced {
	output eDP-1 disable
	output 'Acer Technologies XV273K 0x91709387' enable mode 3840x2160 position 0,0 scale 2
}

profile home-2 {
	output 'LG Electronics IPS235 Serial Number' enable mode 1920x1080 position 0,0 scale 1.2
	output eDP-1 enable position 1600,0
}
